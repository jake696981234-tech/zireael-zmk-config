# Split keyboard configuration - RIGHT PERIPHERAL
# Peripheral role is default when ZMK_SPLIT=y and not central
CONFIG_ZMK_SPLIT=y
CONFIG_ZMK_SLEEP=y

# Enable MPU
CONFIG_ARM_MPU=y

# enable GPIO
CONFIG_GPIO=y

# Enable writing to flash
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# Debugging options - uncomment to troubleshoot split pairing issues
# CONFIG_LOG=y
# CONFIG_ZMK_LOG_LEVEL_DBG=y
# CONFIG_BT_DEBUG_LOG=y
# CONFIG_ZMK_BLE_CLEAR_BONDS_ON_START=y
#
# Disable sleep while debugging (helps identify power/wake issues)
# CONFIG_ZMK_SLEEP=n
# CONFIG_PM=n

# Turn on uf2 build
CONFIG_BUILD_OUTPUT_UF2=y

# Increase transmit power level
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y

# Bluetooth configuration - peripheral only, no USB
CONFIG_ZMK_BLE=y
CONFIG_BT_PERIPHERAL=y
CONFIG_BT_DEVICE_NAME="Dao Right"

# Disable USB completely on peripheral
CONFIG_ZMK_USB=n
CONFIG_USB_DEVICE_STACK=n
