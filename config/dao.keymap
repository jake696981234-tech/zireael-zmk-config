#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NAV   1
#define MOUSE 2
#define MEDIA 3
#define NUM   4
#define SYM   5
#define FUN   6
#define GAME  7
#define BT    8

/* Logical key positions after the Dao matrix transform. */

#define LEFT_HAND_KEYS  0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38
#define RIGHT_HAND_KEYS 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41
#define POS_LEFT_OUTER_THUMB  36
#define POS_RIGHT_OUTER_THUMB 41

/* Miryoku mouse-key acceleration. */

&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <1500>;
    delay-ms = <0>;
};

/ {
    chosen { zmk,matrix_transform = &default_transform; };

    behaviors {
        /*
         * Mirrored home-row modifiers. Same-hand rolls resolve as taps;
         * an opposite-hand key can trigger the modifier hold.
         */

        lhm: left_home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <RIGHT_HAND_KEYS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        rhm: right_home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <LEFT_HAND_KEYS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        mlt: miryoku_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* Hold both physical outer thumb keys to use the BT layer. */

        bt_layer_combo {
            timeout-ms = <50>;
            key-positions = <POS_LEFT_OUTER_THUMB POS_RIGHT_OUTER_THUMB>;
            bindings = <&mo BT>;
            layers = <BASE GAME>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q        &kp W        &kp F           &kp P           &kp B           &kp J          &kp L           &kp U         &kp Y        &kp SQT      &kp BSPC
&kp LCTRL  &lhm LGUI A  &lhm LALT R  &lhm LCTRL S    &lhm LSHFT T    &kp G           &kp M          &rhm LSHFT N    &rhm LCTRL E  &rhm LALT I  &rhm LGUI O  &kp ENTER
&kp LSHFT  &kp Z        &kp X        &kp C           &kp D           &kp V           &kp K          &kp H           &kp COMMA     &kp DOT      &kp SLASH    &kp DEL
                                     &mlt MEDIA ESC  &mlt MOUSE TAB  &mlt NAV SPACE  &mlt NUM BSPC  &mlt SYM ENTER  &mlt FUN DEL
            >;
        };

        navigation_layer {
            display-name = "Navigation";
            bindings = <
&trans  &none     &none     &none      &none      &none  &kp INS     &kp HOME   &kp UP     &kp END    &kp PG_UP  &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none  &caps_word  &kp LEFT   &kp DOWN   &kp RIGHT  &kp PG_DN  &trans
&trans  &none     &kp RALT  &none      &none      &none  &kp LC(Y)   &kp LC(V)  &kp LC(C)  &kp LC(X)  &kp LC(Z)  &key_repeat
                            &none      &none      &none  &kp BSPC    &kp ENTER  &kp DEL
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &none     &none     &none      &none      &none  &none      &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &msc SCRL_UP    &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none  &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN  &trans
&trans  &none     &kp RALT  &none      &none      &none  &kp LC(Y)  &kp LC(V)       &kp LC(C)       &kp LC(X)        &kp LC(Z)       &trans
                            &none      &none      &none  &mkp MB2   &mkp MB1        &mkp MB3
            >;
        };

        vscode_layer {
            display-name = "coding";
            bindings = <
&trans  &none     &none     &none                  &none                &none    &none       &none     &kp F19     &none    &none  &trans
&trans  &kp LGUI  &kp LALT  &lhm LEFT_CONTROL F15  &lhm LEFT_SHIFT F16  &kp F13  &none       &kp F17   &kp F20     &kp F18  &none  &trans
&trans  &kp F14   &kp RALT  &none                  &none                &none    &none       &none     &none       &none    &none  &trans
                            &none                  &none                &none    &kp C_STOP  &kp C_PP  &kp C_MUTE
            >;
        };

        number_layer {
            display-name = "Number";
            bindings = <
&trans  &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT   &none  &none      &none      &none     &none     &trans
&trans  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL  &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &trans
&trans  &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH   &none  &none      &none      &kp RALT  &none     &trans
                           &kp DOT  &kp N0  &kp MINUS  &none  &none      &none
            >;
        };

        symbol_layer {
            display-name = "Symbol";
            bindings = <
&kp TILDE  &kp LBKT  &kp LBRC   &kp LPAR   &kp LESS_THAN     &kp PLUS   &kp EXCL  &kp AT     &kp HASH   &kp DLLR  &kp CARET  &kp SQT
&kp GRAVE  &kp RBKT  &kp RBRC   &kp RPAR   &kp GREATER_THAN  &kp EQUAL  &none     &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI   &kp DQT
&kp PIPE   &kp BSLH  &kp SLASH  &kp STAR   &kp AMPS          &kp PRCNT  &none     &none      &none      &kp RALT  &none      &kp COLON
                                &kp UNDER  &kp MINUS         &kp SEMI   &none     &none      &none
            >;
        };

        function_layer {
            display-name = "Function";
            bindings = <
&trans  &kp F12  &kp F7  &kp F8     &kp F9     &kp PSCRN        &none  &none      &none      &none     &none     &trans
&trans  &kp F11  &kp F4  &kp F5     &kp F6     &kp SLCK         &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &trans
&trans  &kp F10  &kp F1  &kp F2     &kp F3     &kp PAUSE_BREAK  &none  &none      &none      &kp RALT  &none     &trans
                         &kp K_APP  &kp SPACE  &kp TAB          &none  &none      &none
            >;
        };

        game_layer {
            display-name = "Game";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E     &kp R     &kp T      &kp Y      &kp U     &kp I      &kp O    &kp P      &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D     &kp F     &kp G      &kp H      &kp J     &kp K      &kp L    &kp SEMI   &kp ENTER
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V     &kp B      &kp N      &kp M     &kp COMMA  &kp DOT  &kp SLASH  &tog GAME
                         &kp LGUI  &kp LALT  &kp SPACE  &kp SPACE  &kp RALT  &kp RCTRL
            >;
        };

        bluetooth_layer {
            display-name = "Bluetooth";
            bindings = <
&bootloader  &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
&sys_reset   &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &tog GAME
                                         &none         &none         &none         &none         &none         &none
            >;
        };
    };
};
